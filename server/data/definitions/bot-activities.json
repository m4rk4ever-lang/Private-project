{
  "tiers": {
    "novices":       { "skills": [1, 19],  "combat": [3, 30] },
    "intermediates": { "skills": [20, 39], "combat": [30, 60] },
    "advanced":      { "skills": [40, 59], "combat": [60, 90] },
    "experts":       { "skills": [60, 99], "combat": [90, 126] },
    "masters":       { "skills": [80, 99], "combat": [100, 126] },
    "legends":       { "skills": [90, 99], "combat": [115, 126] },
    "maxed":         { "skills": [99, 99], "combat": [126, 126] }
  },
  "templates": {
    "chop_trees": {
      "mode": "woodcutting",
      "repeat": true,
      "requires": [{"skill":{"id":"woodcutting","min":"$level"}}],
      "setup": [],
      "produces": ["logs","woodcutting"],
      "actions": [
        {"type":"equipTool","tool":"axe"},
        {
          "type": "interactObject",
          "catalog": "tree",
          "tier": "$tier",
          "option": "Chop down",
          "until": {"inventoryFull":true},
          "stallSeconds": 120
        },
        {
          "type": "choose",
          "options": [
            {"weight":1,"actions":[{"type":"dropItems","itemIds":["$log"]}]},
            {
              "weight": 1,
              "actions": [
                {
                  "type": "sellItems",
                  "itemIds": ["$log"],
                  "orElse": {"type":"dropItems","itemIds":["$log"]}
                }
              ]
            },
            {"weight":1,"actions":[{"type":"ensureItem","item":"tinderbox"},{"type":"lightFire"}]}
          ]
        }
      ]
    },
    "mine_rocks": {
      "mode": "mining",
      "repeat": true,
      "requires": [{"skill":{"id":"mining","min":"$level"}}],
      "setup": [],
      "actions": [
        {"type":"equipTool","tool":"pickaxe"},
        {
          "type": "interactObject",
          "catalog": "rock",
          "tier": "$tier",
          "option": "Mine",
          "until": {"inventoryFull":true},
          "stallSeconds": 120
        },
        {
          "type": "choose",
          "options": [
            {"weight":1,"actions":[{"type":"dropItems","itemIds":"$resources"}]},
            {
              "weight": 1,
              "actions": [
                {
                  "type": "sellItems",
                  "itemIds": "$resources",
                  "orElse": {"type":"dropItems","itemIds":"$resources"}
                }
              ]
            },
            {
              "weight": 1,
              "actions": [
                {"type":"smelt","bar":"$bar"},
                {
                  "type": "bank",
                  "itemIds": ["$bar"],
                  "orElse": {
                    "type": "sellItems",
                    "itemIds": ["$bar"],
                    "orElse": {"type":"dropItems","itemIds":["$bar"]}
                  }
                }
              ]
            },
            {
              "weight": 1,
              "actions": [
                {"type":"smelt","bar":"$bar"},
                {
                  "type": "sellItems",
                  "itemIds": "$smelted",
                  "orElse": {"type":"dropItems","itemIds":"$smelted"}
                }
              ]
            },
            {
              "weight": 1,
              "actions": [{"type":"smelt","bar":"$bar"},{"type":"dropItems","itemIds":"$smelted"}]
            }
          ]
        }
      ]
    },
    "catch_fish": {
      "mode": "fishing",
      "repeat": true,
      "requires": [{"skill":{"id":"fishing","min":"$level"}}],
      "setup": [],
      "produces": ["fish","fishing"],
      "actions": [
        {"type":"ensureItem","item":"$tool"},
        {"type":"fish","tool":"$spotTool","bait":"$bait","until":{"inventoryFull":true}},
        {
          "type": "choose",
          "options": [
            {"weight":1,"actions":[{"type":"dropItems","itemIds":"$resources"}]},
            {
              "weight": 1,
              "actions": [
                {
                  "type": "sellItems",
                  "itemIds": "$resources",
                  "orElse": {"type":"dropItems","itemIds":"$resources"}
                }
              ]
            },
            {
              "weight": 1,
              "actions": [
                {"type":"cook"},
                {
                  "type": "bank",
                  "itemIds": "$dishes",
                  "orElse": {
                    "type": "sellItems",
                    "itemIds": "$dishes",
                    "orElse": {"type":"dropItems","itemIds":"$dishes"}
                  }
                },
                {"type":"dropItems","itemIds":"$cooked"}
              ]
            },
            {
              "weight": 1,
              "actions": [
                {"type":"cook"},
                {
                  "type": "sellItems",
                  "itemIds": "$cooked",
                  "orElse": {"type":"dropItems","itemIds":"$cooked"}
                }
              ]
            },
            {"weight":1,"actions":[{"type":"cook"},{"type":"dropItems","itemIds":"$cooked"}]}
          ]
        }
      ]
    },
    "steal_from_stalls": {
      "mode": "thieving",
      "repeat": true,
      "requires": [{"skill":{"id":"thieving","min":"$level"}}],
      "setup": [],
      "actions": [
        {
          "type": "interactObject",
          "catalog": "stall",
          "tier": "$tier",
          "option": "Steal-from",
          "until": {"inventoryFull":true},
          "stallSeconds": 120
        },
        {
          "type": "choose",
          "options": [
            {"weight":2,"actions":[{"type":"dropItems","itemIds":"$loot"}]},
            {
              "weight": 1,
              "actions": [
                {
                  "type": "sellItems",
                  "itemIds": "$loot",
                  "orElse": {"type":"dropItems","itemIds":"$loot"}
                }
              ]
            }
          ]
        }
      ]
    }
  },

{
  "name": "TSPS",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "21" }
  },
  "forwardPorts": [3000, 43594],
  "portsAttributes": {
    "3000": {
      "label": "Spel (client)",
      "onAutoForward": "openBrowser"
    },
    "43594": {
      "label": "Gameserver",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/ports.sh",
  "postAttachCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "codespaces": {
      "openFiles": [".devcontainer/README.md"]
    }
  }
}
